# Public application configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Safaricom Daraja M-Pesa Express (STK Push)
# Start with sandbox. Change to production only after Safaricom approval and testing.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Long, random, private callback path token. Keep identical in the Daraja callback URL registration.
MPESA_CALLBACK_TOKEN=

# Safaricom Daraja disbursements (requires Safaricom production approval)
# Use a shortcode enabled for payouts (Bulk Disbursement / One Account).
MPESA_PAYOUT_SHORTCODE=
MPESA_PAYOUT_INITIATOR_NAME=
MPESA_PAYOUT_SECURITY_CREDENTIAL=
MPESA_PAYOUT_RESULT_URL=
MPESA_PAYOUT_TIMEOUT_URL=
MPESA_B2C_COMMAND_ID=BusinessPayment
